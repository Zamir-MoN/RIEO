generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Product {
  id        String   @id @default(cuid())
  title     String
  price     String
  videoUrl    String
  category    String
  description String?
  buyUrl      String?
  thumbnailUrl String?
  createdAt   DateTime @default(now())
}
